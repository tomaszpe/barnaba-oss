# Barnaba Environment Variables
# ==============================
# Copy this file to .env and fill in your values

# Node.js Gateway
PORT=8080
NODE_ENV=production

# Remote Whisper Service (required by gateway)
WHISPER_SERVICE_URL=https://your-whisper.internal.azurecontainerapps.io

# Whisper container/model configuration
WHISPER_MODEL=Flurin17/whisper-large-v3-turbo-swiss-german
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=de
WHISPER_CORS_ALLOWED_ORIGINS=https://your-gateway.azurecontainerapps.io,https://your-control-plane.azurecontainerapps.io

# Gateway CORS. Set the concrete Azure Container Apps browser origins,
# comma-separated. Do not put the internal Whisper address here.
CORS_ALLOWED_ORIGINS=https://your-gateway.azurecontainerapps.io,https://your-control-plane.azurecontainerapps.io

# Emission controller / live latency policy
EMISSION_CONTROLLER_ENABLED=true
EMISSION_CONTROLLER_QUALITY_SEC=3
EMISSION_CONTROLLER_FAST_SEC=7
EMISSION_CONTROLLER_CATCHUP_SEC=12
EMISSION_CONTROLLER_DROP_SEC=20
EMISSION_CONTROLLER_UNHEALTHY_QUEUE_DEPTH=4
EMISSION_CONTROLLER_OVERLOADED_QUEUE_DEPTH=8

# Provider resilience
GPT_TIMEOUT_MS=15000
GPT_CIRCUIT_FAILURE_THRESHOLD=3
GPT_CIRCUIT_COOLDOWN_MS=30000
REQUEST_INVALID_ALERT_THRESHOLD=3
REQUEST_INVALID_ALERT_WINDOW_MS=60000
TRANSLATION_SAFE_ANNOTATION_SAMPLE_EVERY=20

# Content-filter recovery (P0B). Keep OFF until a measured DEV canary is approved.
CONTENT_FILTER_RECOVERY_ENABLED=false
CONTENT_FILTER_RECOVERY_LANGS=
CONTENT_FILTER_SOURCE_ONLY_FOR_SESSION=true
CONTENT_FILTER_RETRY_MAX_AGE_MS=10000
CONTENT_FILTER_RETRY_BUDGET_COUNT=3
CONTENT_FILTER_RETRY_BUDGET_WINDOW_MS=60000
CONTENT_FILTER_HALF_OPEN_AFTER_MS=120000
CONTENT_FILTER_HALF_OPEN_MAX_MS=900000

TTS_CIRCUIT_FAILURE_THRESHOLD=3
TTS_CIRCUIT_COOLDOWN_MS=30000

# Listener delivery scheduler. Set identically on Gateway and Control Plane because
# the listener may fetch /api/control/config from either surface during rollout.
LISTENER_BOUNDED_SCHEDULER_ENABLED=false
FQF_T2_SUPERSESSION_SHADOW_ENABLED=false
FQF_T2_SUPERSESSION_APPLY_ENABLED=false
FQF_T4_SOURCE_RESEGMENTATION_ENABLED=false
LISTENER_CATCHUP_MAX_RATE=1.3
LISTENER_CATCHUP_CHUNK_AGE_SEC=10
LISTENER_BACKLOG_BUDGET_SEC=15
LISTENER_PLAYBACK_POLICY_V2_ENABLED=false

# Early Catch-up. Accelerates EARLY, on
# the age axis only, and holds with hysteresis instead of fluttering. Defaults are the
# spec's, so the A/B changes exactly one thing: the flag. The effective ceiling is still
# LISTENER_CATCHUP_MAX_RATE, applied client-side.
# Sizing (baseline 04.08): demand 912.4 s vs 775.5 s of total playing time => covering it
# needs 1.177x; 1.25 clears that with ~6% to spare. Player occupancy of the exposure window
# is 95.9% (767.3 s clipped to the window; the 96.9% first reported counted an 8.2 s tail
# that played in the outcome grace, which is not part of the window).
LISTENER_EARLY_CATCHUP_ENABLED=false
LISTENER_EARLY_CATCHUP_ENTER_MS=2500
LISTENER_EARLY_CATCHUP_EXIT_MS=1200
LISTENER_EARLY_CATCHUP_DWELL_MS=15000
LISTENER_EARLY_CATCHUP_RATE=1.25

# B4 rhetorical-repeat protection is measured in shadow before a separate A/B.
B4_RHETORICAL_REPEAT_APPLY_ENABLED=false

# Eval logging is OFF by default because it writes full sermon source text and
# translations to app/logs/eval-*.jsonl. Enable only for an access-controlled,
# time-bounded evaluation and delete or archive the files under your retention policy.
EVAL_LOGGING_ENABLED=false
EVAL_LOG_QUEUE_MAX=5000

# REP E0-E2 — ASR repetition fault localization + Whisper-side HMAC ledger.
# Active MVP supports only off|shadow. There is deliberately no apply mode.
# Set the same mode/ngram size on Whisper and Gateway for a controlled DEV capture.
ASR_REP_MODE=off
ASR_REP_NGRAM_WORDS=8
ASR_REP_LEDGER_MAX_FINGERPRINTS=50000
# Never enable in ordinary telemetry. The automated, access-controlled DEV oracle
# temporarily enables it and stores the resulting logs in its protected run folder.
ASR_REP_PROTECTED_TEXT_ENABLED=false

# Targeted REP E3 Gateway same-input partial -> deadline re-dispatch repair.
# Independent of ASR_REP_MODE; not generic Whisper suppression. Default OFF.
REP_E3_FALLBACK_GUARD_ENABLED=false

# Intra-emission source dedup (Phase 1, sprint 25-26.06)
# Consolidates duplicated DE source sentences/clauses BEFORE the GPT fan-out so
# every language (12 + future) inherits a clean input. Lexical, deterministic.
# ON for the current DEV sprint (apply mode) to drive the golden A/B gate.
INTRA_EMISSION_DEDUP_ENABLED=true
# Phase 2 (semantic embedding fallback) stays OFF / dry-run until Phase 1 data lands.
INTRA_EMISSION_DEDUP_SEMANTIC=false
INTRA_SEMANTIC_DRY_RUN=true

# Source release audit (step 1, open-cut diagnosis) - shadow-only logging at every
# processCompleteSentence entry (origin + boundary/governor signals). No behavior change.
SOURCE_RELEASE_AUDIT_ENABLED=true

# P2.7 — cross-emission semantic repeats. SHADOW ONLY: scores full closed DE source
# units against a short history and logs a verdict. Never suppresses, never touches
# text/fan-out/TTS. Suppression is a separate, still-blocked decision.
# NOTE: the `source_semantic_reference` record (the pre-policy R denominator) is emitted
# regardless of this flag — the flag gates scoring only.
SOURCE_SEMANTIC_REPEAT_SHADOW_ENABLED=false
# History is bounded by BOTH a time window and a unit cap: the cap alone missed families
# returning after 88-116 s, the window alone grows without bound during dense speech.
P27_SHADOW_WINDOW_SEC=150
P27_SHADOW_MAX_HISTORY=32
# Two thresholds scored in one pass: 0.75 = high-precision candidate, 0.70 = EXPLORATORY
# only (3 known false positives offline — never promote it to an apply threshold).
P27_SHADOW_TAU_HIGH=0.75
P27_SHADOW_TAU_EXPLORATORY=0.70
P27_SHADOW_MAX_NEW_TOKENS=2
P27_SHADOW_MAX_QUEUE=32

# Azure OpenAI (GPT-4.1-mini for translations)
AZURE_OPENAI_ENDPOINT=https://your-openai-endpoint.openai.azure.com/
AZURE_OPENAI_KEY=your-openai-api-key

# Authentication
#
# Both of these are read at module load by app/authService.js and the gateway
# REFUSES TO START without them. ACCESS_PIN must be exactly six digits.
#
# DELIBERATELY EMPTY. An earlier version shipped working placeholder credentials,
# so an operator could deploy a system whose password was already public. Empty
# values fail at startup with a message naming the variable, which is the correct
# outcome for a placeholder.
ACCESS_PIN=
BROADCASTER_PASSWORD=

# Path to the church whitelist. Defaults to app/config/churches.json; set this
# when the file is mounted elsewhere. The file must exist and be a non-empty
# array, otherwise the gateway throws while loading authService.
# CHURCHES_CONFIG_PATH=/app/config/churches.json

# Server-side TTS (Azure Cognitive Services Speech)
# Enables consistent voice quality across all devices
USE_SERVER_TTS=true
AZURE_SPEECH_KEY=your-speech-api-key
AZURE_SPEECH_REGION=swedencentral

# NOTE: the Whisper service requires an NVIDIA GPU (CUDA, fp16). There is no
# supported CPU configuration for the service: on CPU the streaming pipeline
# stops keeping up with speech, which is a different failure than "slower".
# See the Requirements section of the README for VRAM, cold start and cost.
# (Unit tests do not require a GPU; see the test setup instructions.)
